{
  "name": "webtoapp",
  "version": "0.0.0",
  "private": true,
  "description": "Secure, store-ready web application packaging platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.15.1"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo run clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "node tooling/scripts/generate-contracts.mjs",
    "generate:check": "node tooling/scripts/generate-contracts.mjs --check",
    "test:contract": "node tooling/scripts/test-contract.mjs",
    "desktop:preview": "pnpm --filter @webtoapp/desktop-runtime exec tauri build --debug --no-bundle",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "prettier": "^3.6.2",
    "quicktype-core": "26.0.0",
    "turbo": "^2.5.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.42.0"
  }
}
