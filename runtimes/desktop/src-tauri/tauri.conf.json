{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebToApp Runtime",
  "version": "0.0.0",
  "identifier": "dev.webtoapp.runtime",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["local-shell"]
    },
    "windows": [
      {
        "label": "main",
        "title": "WebToApp",
        "width": 560,
        "height": 360,
        "center": true,
        "resizable": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/appspec.json"]
  }
}
